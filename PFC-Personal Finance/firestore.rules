rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownedOnCreate() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownedOnWrite() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    function ownedOnReadOrDelete() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /categories/{categoryId} {
      allow create: if ownedOnCreate();
      allow read, delete: if ownedOnReadOrDelete();
      allow update: if ownedOnWrite();
    }

    match /transactions/{transactionId} {
      allow create: if ownedOnCreate();
      allow read, delete: if ownedOnReadOrDelete();
      allow update: if ownedOnWrite();
    }

    match /budgets/{budgetId} {
      allow create: if ownedOnCreate();
      allow read, delete: if ownedOnReadOrDelete();
      allow update: if ownedOnWrite();
    }

    match /saving_goals/{goalId} {
      allow create: if ownedOnCreate();
      allow read, delete: if ownedOnReadOrDelete();
      allow update: if ownedOnWrite();
    }

    match /saving_challenges/{challengeId} {
      allow create: if ownedOnCreate();
      allow read, delete: if ownedOnReadOrDelete();
      allow update: if ownedOnWrite();
    }
  }
}
