# Session cookie signing key (HMAC-SHA256). Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PFC_SESSION_SECRET=
# libSQL URL. Local file by default; Turso in production (libsql://...).
PFC_DB_URL=file:.data/pfc.sqlite
# Required only for Turso URLs.
PFC_DB_AUTH_TOKEN=
# Existing hub backends, reached through same-origin proxy rewrites (ADR-010).
CLUB_API_ORIGIN=http://127.0.0.1:3000
OPP_API_ORIGIN=http://127.0.0.1:3001
# Comma-separated emails that become Chủ nhiệm when they register (bootstrap a fresh install).
PFC_OWNER_EMAILS=
# Platform SSO shared secrets (ADR-011); must equal the hub-side values.
CLUB_SSO_SECRET=
OPP_SSO_SECRET=

# --- Đăng nhập (SYS-02…06) ---
# Public origin used in email links and OAuth redirect URIs (never taken from the request Host header).
PFC_PUBLIC_URL=http://localhost:3200
# Google: OAuth client (Web). Authorised redirect URI: <PFC_PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login. Valid OAuth redirect URI: <PFC_PUBLIC_URL>/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Email: "log" prints messages to the server log (dev only); "resend" sends via Resend.
PFC_MAIL_MODE=
RESEND_API_KEY=
PFC_MAIL_FROM=
# 1 = members must verify their email before password login.
PFC_REQUIRE_EMAIL_VERIFICATION=

# --- Lưu ảnh tải lên ---
# "blob" = Vercel Blob (production, cần BLOB_READ_WRITE_TOKEN); để trống = ổ đĩa .data/uploads (máy dev).
PFC_STORAGE=
BLOB_READ_WRITE_TOKEN=
# "local" = đang chạy bản build production trên máy dev (npm start) — bỏ qua kiểm tra cấu hình production.
PFC_ENV=

# --- Xác thực hai lớp ---
# Khóa mã hóa (≥ 32 ký tự, KHÁC PFC_SESSION_SECRET). Mất/đổi khóa này = mọi người phải bật lại 2FA.
PFC_ENCRYPTION_KEY=

# --- Thông báo đẩy (Web Push) ---
# Tạo một lần: node -e "console.log(require('web-push').generateVAPIDKeys())"
PFC_VAPID_PUBLIC_KEY=
PFC_VAPID_PRIVATE_KEY=
# mailto: hoặc https: liên hệ của PFC (bắt buộc theo chuẩn Web Push)
PFC_VAPID_SUBJECT=

# --- Thanh toán trực tuyến VNPAY (G5) ---
# Để trống = tắt thanh toán trực tuyến (chỉ COD / chuyển khoản trực tiếp / thu tại quầy).
# Lấy từ VNPAY (môi trường sandbox: đăng ký tại sandbox.vnpayment.vn). Return URL = <PFC_PUBLIC_URL>/api/payments/vnpay/return,
# IPN URL (khai báo với VNPAY) = <PFC_PUBLIC_URL>/api/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Bỏ trống = sandbox. Production: địa chỉ VNPAY cấp khi ký hợp đồng.
VNPAY_PAY_URL=
VNPAY_API_URL=
# Phí nền tảng PFC tính trên mỗi khoản bán (basis points: 100 = 1%). Mặc định 0.
PFC_PLATFORM_FEE_BPS=

# --- Việc định kỳ (/api/jobs/tick: hết hạn thanh toán, nhắc lịch sự kiện) ---
# Chuỗi ngẫu nhiên ≥ 16 ký tự; Vercel Cron tự gửi kèm "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
