# Local SQLite (demo). Production uses Turso via TURSO_DATABASE_URL below (ADR-005).
DATABASE_URL="file:./dev.db"

# Production (Vercel): Turso. When set, the app ignores DATABASE_URL and uses the libSQL driver adapter.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# "db" = store CV bytes in the database (required on Vercel: no persistent disk). Empty = data/private-cv on disk.
OPP_FILE_STORAGE=

# Required for jobs (/api/jobs/tick, Vercel Cron). ≥ 16 random chars in production. Never expose to the browser.
CRON_SECRET="change-me"
# HMAC for CV download links. Min 16 chars. Never send the raw file path.
CV_SIGNING_SECRET="change-me-at-least-16"
# Worker loop. Production: 900000 (15 min). Jobs must not run in the request path.
JOB_INTERVAL_MS="900000"
# Email/push stay SKIPPED until these are set. Do not fake a sent status.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@pfc.vn
# PUSH_WEBHOOK_URL=

# Platform SSO (PFC App gateway). Must equal PFC-App OPP_SSO_SECRET.
OPP_SSO_SHARED_SECRET=
